# ── AWS Region ───────────────────────────────────────────────────────────────
# Source: `tofu output aws_region` from infra/
VITE_AWS_REGION=us-east-1

# ── Cognito (managed by infra/ — SPEC-006, SPEC-011) ────────────────────────
# Source: `tofu output` from infra/ after apply
#   cognito_user_pool_id        → VITE_COGNITO_USER_POOL_ID
#   cognito_user_pool_client_id → VITE_COGNITO_USER_POOL_CLIENT_ID
#   cognito_domain              → VITE_COGNITO_DOMAIN
#   cognito_identity_pool_id    → VITE_COGNITO_IDENTITY_POOL_ID
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX
VITE_COGNITO_DOMAIN=your-domain.auth.us-east-1.amazoncognito.com
# Identity Pool — exchanges the User Pool token for scoped AWS credentials
# (SPEC-011). Replaces the former VITE_IAM_ROLE_ARN; the app never needs a role
# ARN (role binding is Identity Pool config; per-user scoping via principal tags).
VITE_COGNITO_IDENTITY_POOL_ID=us-east-1:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ── S3 Buckets ───────────────────────────────────────────────────────────────
# User-space bucket (Bucket 1) is managed by infra/ (SPEC-010).
#   Source: `tofu output s3_user_space_bucket_name`
# Consumed by the app starting SPEC-013 (file browser switchover).
VITE_S3_USER_SPACE_BUCKET=user-space-bucket-name
# Shared-space bucket (Bucket 2) — access model still under design; not yet
# provisioned by infra/ (future spec).
VITE_S3_SHARED_SPACE_BUCKET=shared-space-bucket-name

# ── Uploads (SPEC-016) ───────────────────────────────────────────────────────
# Maximum single-file upload size in bytes. Optional — defaults to 5 GiB
# (5368709120) when unset. Files above this are rejected client-side before any
# request. Uploads use the managed lib-storage Upload (auto-multipart above 5 MiB).
VITE_MAX_UPLOAD_BYTES=5368709120

# ── Analytics (SPEC-032 / consumed starting SPEC-034) ────────────────────────
# Shared Athena workgroup every user queries through, managed by infra/ (SPEC-032).
#   Source: `tofu output athena_workgroup_name`
# The app derives the per-user results location from VITE_S3_USER_SPACE_BUCKET +
# {username}/athenaresults/, so there is NO separate results-bucket variable.
VITE_ATHENA_WORKGROUP=dat-prod-portal-wg

# ── Shared connections (SPEC-051) ────────────────────────────────────────────
# FIFO request queue the browser enqueues shared-space create/manage requests onto
# (its only privileged shared-space action). Managed by infra/ (SPEC-050).
#   Source: `tofu output shared_space_request_queue_url`
VITE_SHARED_SPACE_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/dat-prod-shared-space-requests.fifo

# ── Notifications (SPEC-058 / consumed starting SPEC-059) ────────────────────
# FIFO request queue the browser enqueues notification user-actions onto
# (markRead/markAllRead — its only notifications privilege; the writer Lambda is
# the sole writer of notifications.json). Managed by infra/ (SPEC-058). Set
# MessageGroupId = username for per-user ordering.
#   Source: `tofu output notifications_queue_url`
VITE_NOTIFICATIONS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/dat-prod-notifications-requests.fifo

# ── Table Builder (SPEC-066 export / granted SPEC-067 / used SPEC-071) ───────
# FIFO request queue the browser enqueues "create table from this folder" requests
# onto. The portal role's only table-builder privilege is sqs:SendMessage here
# (SPEC-067); the send helper that uses it lands in SPEC-071. FIFO, so the send must
# set MessageGroupId = target database + a MessageDeduplicationId. Managed by infra/.
#   Source: `tofu output table_build_queue_url`
#   NOTE (SPEC-071): wire this into deploy-app.yml's build env + set the GH repo
#   variable, or production ships it undefined (the VITE_* deploy gotcha).
VITE_TABLE_BUILD_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/000000000000/dat-prod-table-builder-requests.fifo

# ── App URL ──────────────────────────────────────────────────────────────────
# Production: set to `tofu output cloudfront_domain` after first deploy
# Local dev:  http://localhost:5173
VITE_APP_URL=http://localhost:5173

# ── Local dev only ───────────────────────────────────────────────────────────
# The variables below browse a static/public test bucket WITHOUT auth, for local
# work without AWS (the SPEC-001/002 path). They are honoured only when
# VITE_S3_DEV_UNAUTH=true AND running a dev build (`npm run dev`); the path is
# stripped from production builds, where /files always uses the authenticated
# user-space bucket (SPEC-013).
#
# Set VITE_S3_DEV_UNAUTH=true to enable the unauthenticated dev browser (this also
# bypasses the /files auth gate in dev). Leave it unset/false to use the real
# authenticated flow against VITE_S3_USER_SPACE_BUCKET.
VITE_S3_DEV_UNAUTH=
# Leave VITE_AWS_ACCESS_KEY_ID blank to use anonymous (unsigned) S3 requests
# against a publicly accessible test bucket.
VITE_S3_BUCKET_NAME=your-test-bucket-name
VITE_S3_ROOT_PREFIX=
VITE_AWS_ACCESS_KEY_ID=
VITE_AWS_SECRET_ACCESS_KEY=
