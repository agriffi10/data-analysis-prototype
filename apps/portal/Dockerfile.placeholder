# The placeholder image. It exists to prove the PLATFORM — that a Fargate task in a private
# subnet with no NAT gateway can pull from ECR through the VPC endpoints, start, and answer the
# load balancer's health check. It serves no application and is pointed at no user.
#
# The real image is the spec that builds the SPA; this file is deleted when that lands.
#
# ITS CONTRACT, which the task definition already assumes:
#   * listens on 8080 as a NON-ROOT user (uid 101, the base image's own)
#   * answers GET /healthz with 200
#   * runs unchanged with readonlyRootFilesystem, writing only /tmp and /var/cache/nginx
# A placeholder that misses any of these turns the verification it exists for into a task that
# dies for a reason indistinguishable from the pull failure being tested.
#
# BUILD IT FOR THE PLATFORM THE TASK DECLARES, not for the laptop:
#
#   docker build --platform linux/amd64 -f apps/portal/Dockerfile.placeholder -t "$REPO:$SHA" .
#
# On an Apple Silicon machine the default build produces an arm64 image, and the task then
# fails with an image-manifest error that reads nothing like the architecture mismatch it is.

FROM nginxinc/nginx-unprivileged:1.27-alpine

# The unprivileged base already listens on 8080 as uid 101 and writes its pid to /tmp. The
# only thing added here is the two locations, replacing the base image's default site.
#
# Written with printf rather than a heredoc COPY: a heredoc needs a `# syntax=` frontend
# directive and therefore a registry pull before the build starts, which is exactly the kind
# of extra moving part a placeholder should not have.
# The base image drops to uid 101, which cannot write /etc/nginx. Root for the one build
# step, and back to 101 for the runtime — the container itself never runs as root.
USER root
RUN printf '%s\n' \
    'server {' \
    '    listen 8080;' \
    '    server_name _;' \
    '    location = /healthz {' \
    '        access_log off;' \
    '        default_type text/plain;' \
    '        return 200 "ok";' \
    '    }' \
    '    location / {' \
    '        default_type text/plain;' \
    '        return 200 "SPA placeholder. The application image is not deployed yet.";' \
    '    }' \
    '}' \
    > /etc/nginx/conf.d/default.conf

EXPOSE 8080
USER 101
