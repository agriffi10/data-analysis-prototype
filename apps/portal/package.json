{
  "name": "@s3-upload-portal/portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "NEXT_TELEMETRY_DISABLED=1 next dev --port 5173",
    "build": "tsc -b && NEXT_TELEMETRY_DISABLED=1 next build",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:a11y": "vitest run a11y",
    "test:ui": "vitest --ui",
    "check:bundle": "node scripts/assert-bundle-has-no-vite-names.mjs && node scripts/assert-bundle-has-no-server-sdk.mjs",
    "prelint": "node ../../scripts/check-local-install.mjs",
    "preformat:check": "node ../../scripts/check-local-install.mjs",
    "pretest": "node ../../scripts/check-local-install.mjs",
    "pretest:coverage": "node ../../scripts/check-local-install.mjs",
    "prebuild": "node ../../scripts/check-local-install.mjs && node ../../scripts/check-compiler-major.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.102.8",
    "aws-amplify": "^6.20.0",
    "focus-trap-react": "^12.0.3",
    "monaco-editor": "^0.56.0",
    "next": "16.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-security": "^4.0.1",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vitest-axe": "^0.1.0"
  }
}
