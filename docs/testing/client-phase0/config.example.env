# Copy to $WORK/config.env, fill in, and `set -a; . ~/phase0-client/config.env; set +a` in every shell.
# Never commit the filled copy: it names real accounts, users and roles.

# Set here, not only in the shell, because C4 spans more than half an hour and may outlive a shell.
WORK=$HOME/phase0-client

# Where the run keeps what it learns. Both must be outside any git checkout; the scripts refuse otherwise.
PHASE0_EVIDENCE=$WORK/evidence/phase0-evidence.jsonl
PHASE0_SECRETS=$WORK/secrets

AWS_REGION=us-east-1

# The Cognito test pool, federated to Entra. The app client allows the code grant, PKCE, the
# openid email profile scopes, and http://localhost:8766/callback as a callback URL.
COGNITO_DOMAIN=https://<prefix>.auth.<region>.amazoncognito.com
COGNITO_CLIENT_ID=<client id>
# Only for a confidential client; leave empty for a public one.
COGNITO_CLIENT_SECRET=
REDIRECT_PORT=8766
# The pool's name for the Entra identity provider; sign-in skips the provider chooser.
ENTRA_IDP_NAME=<provider name in the pool>
# The ID-token claim the trusted token issuer maps to externalIds.value.
OID_CLAIM=entra_oid

# The organization instance and what the Identity Center admins created.
IDC_APPLICATION_ARN=arn:aws:sso::<idc admin account>:application/<ssoins>/<apl catalog>
IDC_PORTAL_APP_ARN=arn:aws:sso::<idc admin account>:application/<ssoins>/<apl portal>
IDENTITY_STORE_ID=d-<id>
TTI_ARN=arn:aws:sso::<idc admin account>:trustedTokenIssuer/<ssoins>/<tti>

# AWS CLI profiles. Each must resolve to the role named, and the two member-account roles must differ.
EXCHANGER_PROFILE=<profile for phase0-exchanger, member account>
ASSUMER_PROFILE=<profile for phase0-assumer, member account>
CONTROL_PROFILE=<profile for a role in the application's own account, named in the actor policy>
IDSTORE_PROFILE=<profile allowed identitystore:DescribeUser, sso:DescribeTrustedTokenIssuer and sso:GetApplicationAuthenticationMethod>

# Member-account fixtures.
CARRIER_ROLE_ARN=arn:aws:iam::<member account>:role/phase0-carrier
ACCESS_GRANTS_ACCOUNT_ID=<member account>
PROBE_BUCKET=<scratch bucket>
OTHER_USER_KEY=phase0-probe/other-user/secret.txt
PUT_PREFIX=phase0-probe/put/
LIST_PREFIX=phase0-probe/
SCRATCH_QUEUE_URL=https://sqs.<region>.amazonaws.com/<member account>/phase0-scratch
IDC_WORKGROUP=phase0-idc
PROBE_QUERY='SELECT count(*) FROM phase0_db.phase0_t'

# Check 3, the permission set.
PSET_ACCOUNT_ID=<member account>
PSET_NAME=Phase0Probe
P2_OWN_KEY=phase0-probe/abac/<alice's Identity Center user name>/probe.txt
P2_OTHER_KEY=phase0-probe/abac/<bob's Identity Center user name>/probe.txt
P3_PREFIX=phase0-probe/p3/

# Check 5. The object id is read from the Entra admin center for the alice test user.
ENTRA_TEST_USER_OID=<object id>
EXPECTED_IDC_USERNAME=<alice's Identity Center user name>
