{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ProbeObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject"],
      "Resource": "arn:aws:s3:::<PROBE_BUCKET>/phase0-probe/*"
    },
    {
      "Sid": "ProbeListing",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<PROBE_BUCKET>",
      "Condition": { "StringLike": { "s3:prefix": "phase0-probe/*" } }
    },
    {
      "Sid": "OffListProbe",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "arn:aws:sqs:<REGION>:<MEMBER_ACCOUNT_ID>:phase0-scratch"
    },
    {
      "Sid": "SeeOwnGrants",
      "Effect": "Allow",
      "Action": "s3:ListCallerAccessGrants",
      "Resource": "*"
    }
  ]
}
