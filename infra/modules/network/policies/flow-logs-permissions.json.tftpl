{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteFlowLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "${log_group_arn}",
        "${log_group_arn}:*"
      ]
    }
  ]
}
