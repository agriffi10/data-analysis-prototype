{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublishFlowLogsToTheGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "${log_group_arn}",
        "${log_group_arn}:*"
      ]
    },
    {
      "Sid": "ListLogGroups",
      "Effect": "Allow",
      "Action": "logs:DescribeLogGroups",
      "Resource": "*"
    }
  ]
}
