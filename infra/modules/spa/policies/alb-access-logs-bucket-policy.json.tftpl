{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowLoadBalancerAccessLogDelivery",
      "Effect": "Allow",
      "Principal": {
        "Service": "logdelivery.elasticloadbalancing.amazonaws.com"
      },
      "Action": "s3:PutObject",
      "Resource": "${bucket_arn}/${access_logs_prefix}/AWSLogs/${account_id}/*"
    },
    {
      "Sid": "AllowLoadBalancerAccessLogDeliveryLegacy",
      "Effect": "Allow",
      "Principal": {
        "AWS": "${elb_account_arn}"
      },
      "Action": "s3:PutObject",
      "Resource": "${bucket_arn}/${access_logs_prefix}/AWSLogs/${account_id}/*"
    }
  ]
}
