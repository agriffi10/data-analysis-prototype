{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UseTheSessionTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "${session_table_arn}"
    },
    {
      "Sid": "UseTheSessionTablesKeyThroughDynamoDB",
      "Effect": "Allow",
      "Action": [
        "kms:Decrypt",
        "kms:Encrypt",
        "kms:GenerateDataKey*",
        "kms:ReEncrypt*"
      ],
      "Resource": "arn:aws:kms:${aws_region}:${account_id}:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "dynamodb.${aws_region}.amazonaws.com",
          "kms:EncryptionContext:aws:dynamodb:tableName": "${session_table_name}"
        }
      }
    },
    {
      "Sid": "DescribeTheSessionTablesKeyThroughDynamoDB",
      "Effect": "Allow",
      "Action": "kms:DescribeKey",
      "Resource": "arn:aws:kms:${aws_region}:${account_id}:key/*",
      "Condition": {
        "StringEquals": {
          "kms:ViaService": "dynamodb.${aws_region}.amazonaws.com"
        }
      }
    }
  ]
}
