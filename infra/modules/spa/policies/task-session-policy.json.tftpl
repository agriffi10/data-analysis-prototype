{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "UseTheSessionTable",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem"
      ],
      "Resource": "${session_table_arn}"
    }
  ]
}
