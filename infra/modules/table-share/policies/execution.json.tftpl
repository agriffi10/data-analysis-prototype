{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EmitNotifications",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "${notifications_queue_arn}"
    },
    {
      "Sid": "RegistryRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${admin_bucket_arn}/shared-spaces/*"
    },
    {
      "Sid": "CopyPlanReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "${admin_bucket_arn}/table-share/*"
    },
    {
      "Sid": "RecipientUserCheck",
      "Effect": "Allow",
      "Action": [
        "cognito-idp:AdminGetUser",
        "cognito-idp:ListUsers"
      ],
      "Resource": "${user_pool_arn}"
    },
    {
      "Sid": "SourceDataList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "${user_space_bucket_arn}",
        "${shared_space_bucket_arn}"
      ]
    },
    {
      "Sid": "SourceDataRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "${user_space_bucket_arn}/*",
        "${shared_space_bucket_arn}/*"
      ]
    },
    {
      "Sid": "SharedTablesWrite",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "${user_space_bucket_arn}/*/shared_tables/*",
        "${shared_space_bucket_arn}/*/shared_tables/*"
      ]
    },
    {
      "Sid": "NoDataObjectDelete",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": [
        "${user_space_bucket_arn}/*",
        "${shared_space_bucket_arn}/*",
        "${admin_bucket_arn}/*"
      ]
    },
    {
      "Sid": "GlueDescribeCreate",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetTable",
        "glue:CreateTable"
      ],
      "Resource": [
        "${glue_catalog_arn}",
        "${glue_database_any}",
        "${glue_table_any}"
      ]
    },
    {
      "Sid": "AthenaRunDdl",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:StopQueryExecution",
        "athena:GetWorkGroup"
      ],
      "Resource": "${athena_workgroup_arn}"
    },
    {
      "Sid": "LakeFormationDataAccess",
      "Effect": "Allow",
      "Action": "lakeformation:GetDataAccess",
      "Resource": "*"
    },
    {
      "Sid": "AthenaResultsWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": [
        "${user_space_bucket_arn}/*/athenaresults/*",
        "${shared_space_bucket_arn}/*/athenaresults/*"
      ]
    },
    {
      "Sid": "WriteLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "${log_group_arn}:*"
    }
  ]
}
