{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EmitNotifications",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "${notifications_queue_arn}"
    },
    {
      "Sid": "RegistryRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${admin_bucket_arn}/shared-spaces/*"
    },
    {
      "Sid": "SpaceLockReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "${admin_bucket_arn}/${lock_prefix}/*"
    },
    {
      "Sid": "PlanReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "${admin_bucket_arn}/${plan_prefix}/*"
    },
    {
      "Sid": "ListSpaces",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "${user_space_bucket_arn}",
        "${shared_space_bucket_arn}"
      ]
    },
    {
      "Sid": "ReadSpaceObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "${user_space_bucket_arn}/*",
        "${shared_space_bucket_arn}/*"
      ]
    },
    {
      "Sid": "NoDataObjectWrite",
      "Effect": "Deny",
      "Action": [
        "s3:Put*",
        "s3:Delete*",
        "s3:Restore*",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "${user_space_bucket_arn}/*",
        "${shared_space_bucket_arn}/*"
      ]
    },
    {
      "Sid": "NoLockDelete",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": "${admin_bucket_arn}/*"
    },
    {
      "Sid": "ReadTimedOutExecutionInput",
      "Effect": "Allow",
      "Action": "states:DescribeExecution",
      "Resource": "${execution_arn_wildcard}"
    },
    {
      "Sid": "EmitStructuredLogEvents",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "${logs_queue_arn}"
    },
    {
      "Sid": "WriteLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "${log_group_arn}:*"
    }
  ]
}
