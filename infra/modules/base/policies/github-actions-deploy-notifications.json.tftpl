{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NotificationsProbeInvoke",
      "Effect": "Allow",
      "Action": "lambda:InvokeFunction",
      "Resource": "arn:aws:lambda:${aws_region}:${account_id}:function:${project_name}-*-notifications-writer"
    },
    {
      "Sid": "NotificationsQueuesManage",
      "Effect": "Allow",
      "Action": [
        "sqs:CreateQueue",
        "sqs:DeleteQueue",
        "sqs:GetQueueUrl",
        "sqs:GetQueueAttributes",
        "sqs:SetQueueAttributes",
        "sqs:ListQueueTags",
        "sqs:TagQueue",
        "sqs:UntagQueue",
        "sqs:AddPermission",
        "sqs:RemovePermission"
      ],
      "Resource": "arn:aws:sqs:${aws_region}:${account_id}:${project_name}-*-notifications-*"
    },
    {
      "Sid": "NotificationsWriterLambdaManage",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateFunction",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:GetFunctionCodeSigningConfig",
        "lambda:GetFunctionConcurrency",
        "lambda:GetRuntimeManagementConfig",
        "lambda:UpdateFunctionCode",
        "lambda:UpdateFunctionConfiguration",
        "lambda:PublishVersion",
        "lambda:DeleteFunction",
        "lambda:ListVersionsByFunction",
        "lambda:GetPolicy",
        "lambda:AddPermission",
        "lambda:RemovePermission",
        "lambda:TagResource",
        "lambda:UntagResource",
        "lambda:ListTags"
      ],
      "Resource": "arn:aws:lambda:${aws_region}:${account_id}:function:${project_name}-*-notifications-writer"
    },
    {
      "Sid": "NotificationsEventSourceMappingManage",
      "Effect": "Allow",
      "Action": [
        "lambda:CreateEventSourceMapping",
        "lambda:GetEventSourceMapping",
        "lambda:UpdateEventSourceMapping",
        "lambda:DeleteEventSourceMapping"
      ],
      "Resource": "*",
      "Condition": {
        "ArnLike": {
          "lambda:FunctionArn": "arn:aws:lambda:${aws_region}:${account_id}:function:${project_name}-*-notifications-writer"
        }
      }
    },
    {
      "Sid": "NotificationsEventSourceMappingList",
      "Effect": "Allow",
      "Action": [
        "lambda:ListEventSourceMappings"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NotificationsEventSourceMappingTags",
      "Effect": "Allow",
      "Action": [
        "lambda:ListTags"
      ],
      "Resource": "arn:aws:lambda:${aws_region}:${account_id}:event-source-mapping:*"
    },
    {
      "Sid": "NotificationsRolesManage",
      "Effect": "Allow",
      "Action": [
        "iam:GetRole",
        "iam:GetRolePolicy",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole",
        "iam:ListRoleTags",
        "iam:CreateRole",
        "iam:DeleteRole",
        "iam:PutRolePolicy",
        "iam:DeleteRolePolicy",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:PassRole"
      ],
      "Resource": "arn:aws:iam::${account_id}:role/${project_name}-*-notifications-*"
    },
    {
      "Sid": "NotificationsLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:ListTagsForResource",
        "logs:TagResource",
        "logs:UntagResource"
      ],
      "Resource": [
        "arn:aws:logs:${aws_region}:${account_id}:log-group:/aws/lambda/${project_name}-*-notifications-writer",
        "arn:aws:logs:${aws_region}:${account_id}:log-group:/aws/lambda/${project_name}-*-notifications-writer:*"
      ]
    }
  ]
}
