{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ControlPlaneCommonLayerManage",
      "Effect": "Allow",
      "Action": [
        "lambda:PublishLayerVersion",
        "lambda:DeleteLayerVersion",
        "lambda:GetLayerVersion",
        "lambda:ListLayerVersions"
      ],
      "Resource": [
        "arn:aws:lambda:${aws_region}:*:layer:${project_name}-*-control-plane-common",
        "arn:aws:lambda:${aws_region}:*:layer:${project_name}-*-control-plane-common:*"
      ]
    }
  ]
}
