{
  "Comment": "Shared-space provisioning orchestrator (SPEC-050 skeleton). Per-action validate/create/grant/cache logic is added in SPEC-051-055; here the Lambda dispatches/echoes the request so the control plane is observable end-to-end.",
  "StartAt": "Dispatch",
  "States": {
    "Dispatch": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${provisioner_function_arn}",
        "Payload.$": "$"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Failed"
        }
      ],
      "Next": "Succeeded"
    },
    "Succeeded": {
      "Type": "Succeed"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "ProvisioningFailed",
      "Cause": "The shared-space provisioner returned an unrecoverable error."
    }
  }
}
