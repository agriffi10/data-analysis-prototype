{
  "Comment": "Shared-space provisioning orchestrator. The provisioner Lambda first VALIDATEs (SPEC-056): verify the caller's Cognito ID token, derive the trusted actor, authorize against the registry. A forged/unauthorized request raises AuthorizationError -> Catch -> Fail with no side effects. Only Lambda SERVICE errors are retried (not AuthorizationError, which is deterministic). Per-action create/grant/cache verbs are stubs until SPEC-051-055.",
  "StartAt": "Dispatch",
  "States": {
    "Dispatch": {
      "Type": "Task",
      "Comment": "Validate (token + registry authorization) then dispatch to the per-action verb (stubbed until SPEC-051-055).",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${provisioner_function_arn}",
        "Payload.$": "$"
      },
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "Failed"
        }
      ],
      "Next": "Succeeded"
    },
    "Succeeded": {
      "Type": "Succeed"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "ProvisioningFailed",
      "Cause": "The shared-space provisioner returned an unrecoverable error."
    }
  }
}
