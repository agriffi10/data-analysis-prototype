{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteLocation",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "${bucket_arn}/*"
    },
    {
      "Sid": "ListLocation",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": "${bucket_arn}"
    }
  ]
}
