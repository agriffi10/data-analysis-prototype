{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CatalogReadBack",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetTableVersion",
        "glue:GetTableVersions",
        "glue:GetPartition",
        "glue:GetPartitions"
      ],
      "Resource": [
        "arn:aws:glue:${aws_region}:${account_id}:catalog",
        "arn:aws:glue:${aws_region}:${account_id}:database/*",
        "arn:aws:glue:${aws_region}:${account_id}:table/*/*"
      ],
      "//": "THREE ARNs, NOT `catalog` + `catalog/*`. Glue has no `catalog/*` hierarchy — every call above needs the DATABASE ARN and the TABLE ARN alongside the catalog, which is the shape `portal-role-analytics` and the table-builder execution role already use. The first version scoped to `catalog/*` and would have applied cleanly and then denied `GetTable` at runtime, leaving the read-back this role exists for blocked with no gate having failed.",
      "///": "NO lakeformation:GetDataAccess anywhere in this policy, and its absence is the point: GetDataAccess is the credential vend for READING A TABLE'S DATA, and this role reads definitions. The `database/*` + `table/*/*` breadth is not a widening — Lake Formation gates every one of these calls INDEPENDENTLY, and this role holds only the DESCRIBE tag grant from modules/analytics."
    },
    {
      "Sid": "ArchiveAuditRead",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "${trail_bucket_arn}",
        "${trail_bucket_arn}/*"
      ]
    },
    {
      "Sid": "TrailStatusRead",
      "Effect": "Allow",
      "Action": [
        "cloudtrail:DescribeTrails",
        "cloudtrail:GetTrailStatus",
        "cloudtrail:GetEventSelectors"
      ],
      "Resource": "${trail_arn}"
    }
  ]
}
