{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NotificationsDocReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "${user_space_bucket_arn}/*/user_settings/notifications.json"
    },
    {
      "Sid": "NotificationsDocList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "${user_space_bucket_arn}",
      "Condition": {
        "StringLike": {
          "s3:prefix": "*/user_settings/notifications.json"
        }
      }
    },
    {
      "Sid": "RequestQueueReceive",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "${request_queue_arn}"
    },
    {
      "Sid": "WriteLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "${lambda_log_group_arn}:*"
    },
    {
      "Sid": "EmitStructuredLogs",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "${logs_queue_arn}"
    }
  ]
}
