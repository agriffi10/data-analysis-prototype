{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WriteOwnLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "${log_group_arn}:*"
    },
    {
      "Sid": "EmitStructuredLogSpans",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "${logs_queue_arn}"
    },
    {
      "Sid": "EnqueueControlPlaneRequests",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": ${request_queue_arns_json}
    },
    {
      "Sid": "MembershipIndexRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${admin_bucket_arn}/memberships/*"
    },
    {
      "Sid": "MembershipIndexList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "${admin_bucket_arn}",
      "Condition": {
        "StringLike": {
          "s3:prefix": "memberships/*"
        }
      }
    },
    {
      "Sid": "AssumeThePortalRoleAsTheCaller",
      "Effect": "Allow",
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Resource": "${portal_role_arn}"
    }
  ]
}
