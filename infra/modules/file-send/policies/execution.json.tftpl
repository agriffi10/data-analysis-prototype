{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EmitNotifications",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "${notifications_queue_arn}"
    },
    {
      "Sid": "RegistryRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${admin_bucket_arn}/shared-spaces/*"
    },
    {
      "Sid": "RecipientUserCheck",
      "Effect": "Allow",
      "Action": "cognito-idp:AdminGetUser",
      "Resource": "${user_pool_arn}"
    },
    {
      "Sid": "CopyPlanWrite",
      "Effect": "Allow",
      "Action": "s3:PutObject",
      "Resource": "${admin_bucket_arn}/file-send/*"
    },
    {
      "Sid": "SourceDataList",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "${user_space_bucket_arn}",
        "${shared_space_bucket_arn}"
      ]
    },
    {
      "Sid": "SourceDataRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "${user_space_bucket_arn}/*",
        "${shared_space_bucket_arn}/*"
      ]
    },
    {
      "Sid": "NoDataObjectDelete",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": [
        "${user_space_bucket_arn}/*",
        "${shared_space_bucket_arn}/*",
        "${admin_bucket_arn}/*"
      ]
    },
    {
      "Sid": "EmitStructuredLogEvents",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "${logs_queue_arn}"
    },
    {
      "Sid": "WriteLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "${log_group_arn}:*"
    }
  ]
}
