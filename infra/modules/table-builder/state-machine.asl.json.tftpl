{
  "Comment": "Table-builder control plane (SPEC-070). A LINEAR pipeline — validate-authorize → check-table-absent → inspect-source → infer-schema → execute-ddl → RecordSuccess → Succeeded — orchestrated by the Step Function, not in-Lambda code. Each Task threads the running request object via Payload.$=$ + OutputPath=$.Payload. Only transient SERVICE errors are retried (Lambda service faults on every verb; infer-schema also retries a throttled S3 head probe, and execute-ddl the Athena polls' TransientError — both mapped in-Lambda to the TransientError this Retry names). Any terminal verb failure is caught and routed to the shared recorded-failure state, which shapes the structured outcome { requestId, actor, database, tableName, status:'failed', reason } SPEC-072 notifies from; RecordSuccess shapes the status:'created' twin. A partitioned table needs NO MSCK REPAIR (projection, SPEC-069) — the single execute-ddl CREATE is terminal for both flat and partitioned sources.",
  "StartAt": "ValidateAuthorize",
  "States": {
    "ValidateAuthorize": {
      "Type": "Task",
      "Comment": "First step. The Pipe forwards the raw SQS batch (a JSON ARRAY), so Payload.$=$ hands the array to the validator (it reads record[0]); OutputPath=$.Payload makes the validated request object the whole state for the next steps. A failure here runs BEFORE the request identity exists, so its Catch (no ResultPath — the input is an array, not an object) routes to ValidateFailureSeed, which seeds null identity fields so the shared recorded-failure state can reference them uniformly.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${validate_authorize_function_arn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "Next": "ValidateFailureSeed"
        }
      ],
      "Next": "CheckTableAbsent"
    },
    "CheckTableAbsent": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${check_table_absent_function_arn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ParseError"
        }
      ],
      "Next": "InspectSource"
    },
    "InspectSource": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${inspect_source_function_arn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ParseError"
        }
      ],
      "Next": "InferSchema"
    },
    "InferSchema": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${infer_schema_function_arn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "TransientError"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ParseError"
        }
      ],
      "Next": "ExecuteDdl"
    },
    "ExecuteDdl": {
      "Type": "Task",
      "Comment": "Run the single CREATE via Athena (projection ⇒ no MSCK REPAIR). A transient Athena/S3 error is raised as TransientError and retried here (NOT terminal); a FAILED/CANCELLED query or timeout raises TerminalError → Catch → recorded failure.",
      "Resource": "arn:aws:states:::lambda:invoke",
      "Parameters": {
        "FunctionName": "${execute_ddl_function_arn}",
        "Payload.$": "$"
      },
      "OutputPath": "$.Payload",
      "Retry": [
        {
          "ErrorEquals": [
            "Lambda.ServiceException",
            "Lambda.TooManyRequestsException",
            "Lambda.AWSLambdaException",
            "Lambda.SdkClientException",
            "TransientError"
          ],
          "IntervalSeconds": 2,
          "MaxAttempts": 3,
          "BackoffRate": 2
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "ParseError"
        }
      ],
      "Next": "RecordSuccess"
    },
    "RecordSuccess": {
      "Type": "Pass",
      "Comment": "Shape the terminal SUCCESS outcome SPEC-072 notifies from. The threaded object always carries these fields after execute-ddl.",
      "Parameters": {
        "requestId.$": "$.requestId",
        "actor.$": "$.actor",
        "database.$": "$.space.database",
        "tableName.$": "$.tableName",
        "status": "created"
      },
      "Next": "Succeeded"
    },
    "ValidateFailureSeed": {
      "Type": "Pass",
      "Comment": "A validate-authorize failure occurs before the request identity exists (its input was the raw SQS array), so its Catch replaced the state with the error object. Seed null identity fields + carry the error under $.error so the shared ParseError/RecordFailure path is uniform for every verb.",
      "Parameters": {
        "requestId": null,
        "actor": null,
        "space": { "database": null },
        "tableName": null,
        "error.$": "$"
      },
      "Next": "ParseError"
    },
    "ParseError": {
      "Type": "Pass",
      "Comment": "Decode the Lambda error Cause (a JSON string) so RecordFailure can read the errorMessage — the 'reason: detail' string TerminalError raised (e.g. 'ddl_execution_failed: SYNTAX_ERROR …').",
      "Parameters": {
        "cause.$": "States.StringToJson($.error.Cause)"
      },
      "ResultPath": "$.parsed",
      "Next": "RecordFailure"
    },
    "RecordFailure": {
      "Type": "Pass",
      "Comment": "The single recorded-failure state every verb's Catch reaches. Shapes the structured outcome { requestId, actor, database, tableName, status:'failed', reason } (identity is null for a pre-identity validate failure) then fails the execution.",
      "Parameters": {
        "requestId.$": "$.requestId",
        "actor.$": "$.actor",
        "database.$": "$.space.database",
        "tableName.$": "$.tableName",
        "status": "failed",
        "reason.$": "$.parsed.cause.errorMessage"
      },
      "Next": "Failed"
    },
    "Succeeded": {
      "Type": "Succeed"
    },
    "Failed": {
      "Type": "Fail",
      "Error": "TableBuildFailed",
      "Cause": "The table-builder control plane recorded an unrecoverable error (see the RecordFailure state output for the structured { status:'failed', reason } outcome)."
    }
  }
}
