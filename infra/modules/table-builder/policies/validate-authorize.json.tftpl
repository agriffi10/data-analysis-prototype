{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RegistryRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${admin_bucket_arn}/shared-spaces/*"
    },
    {
      "Sid": "WriteLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "${log_group_arn}:*"
    }
  ]
}
