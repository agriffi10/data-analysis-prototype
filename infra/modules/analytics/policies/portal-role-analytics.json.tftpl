{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "GlueUserDatabaseScoped",
      "Effect": "Allow",
      "Action": [
        "glue:GetDatabase",
        "glue:GetDatabases",
        "glue:GetTable",
        "glue:GetTables",
        "glue:GetPartition",
        "glue:GetPartitions",
        "glue:CreateTable",
        "glue:UpdateTable",
        "glue:DeleteTable",
        "glue:BatchCreatePartition",
        "glue:BatchDeletePartition"
      ],
      "Resource": [
        "arn:aws:glue:${aws_region}:${account_id}:catalog",
        "arn:aws:glue:${aws_region}:${account_id}:database/$${aws:PrincipalTag/${principal_tag_key}}",
        "arn:aws:glue:${aws_region}:${account_id}:table/$${aws:PrincipalTag/${principal_tag_key}}/*"
      ]
    },
    {
      "Sid": "AthenaQueryExecution",
      "Effect": "Allow",
      "Action": [
        "athena:StartQueryExecution",
        "athena:GetQueryExecution",
        "athena:GetQueryResults",
        "athena:GetQueryResultsStream",
        "athena:StopQueryExecution",
        "athena:BatchGetQueryExecution",
        "athena:GetWorkGroup"
      ],
      "Resource": "${workgroup_arn}"
    },
    {
      "Sid": "LakeFormationDataAccess",
      "Effect": "Allow",
      "Action": "lakeformation:GetDataAccess",
      "Resource": "*"
    },
    {
      "Sid": "ResultsBucketLocation",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "${user_space_bucket_arn}"
    },
    {
      "Sid": "ResultsReadWriteSystemSettings",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "${user_space_bucket_arn}/$${aws:PrincipalTag/${principal_tag_key}}/system_settings/athenaresults/*"
    },
    {
      "Sid": "ResultsNoDeleteSystemSettings",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": "${user_space_bucket_arn}/$${aws:PrincipalTag/${principal_tag_key}}/system_settings/athenaresults/*"
    },
    {
      "Sid": "UserSettingsNoDelete",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": "${user_space_bucket_arn}/$${aws:PrincipalTag/${principal_tag_key}}/user_settings/*"
    }
  ]
}
