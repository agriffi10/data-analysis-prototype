{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "RootUserAssume",
      "Effect": "Allow",
      "Principal": {
        "AWS": "arn:aws:iam::${account_id}:root"
      },
      "Action": "sts:AssumeRole",
      "Condition": {
        "StringEquals": {
          "aws:PrincipalArn": "arn:aws:iam::${account_id}:root"
        }
      }
    }
  ]
}
