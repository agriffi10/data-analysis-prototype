{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DenyDataAccessExceptPortalRole",
      "Effect": "Deny",
      "Principal": "*",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "${bucket_arn}",
        "${bucket_arn}/*"
      ],
      "Condition": {
        "StringNotLike": {
          "aws:PrincipalArn": [
            "${portal_role_arn}",
            "${deploy_role_arn}",
            "${lf_registration_role_arn}",
            "arn:aws:iam::${account_id}:root"
          ]
        }
      }
    }
  ]
}
