{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "TheApiMayActAsAUser",
      "Effect": "Allow",
      "Principal": {
        "AWS": "${api_execution_role_arn}"
      },
      "Action": [
        "sts:AssumeRole",
        "sts:TagSession"
      ],
      "Condition": {
        "ForAllValues:StringEquals": {
          "sts:TagKeys": ${session_tag_keys}
        },
        "Null": {
          "sts:TransitiveTagKeys": "true"
        }
      }
    }
  ]
}
