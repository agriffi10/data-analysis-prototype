# Copy this file to terraform.tfvars and fill in your values.
# terraform.tfvars is gitignored — never commit it.

aws_region        = "us-east-1"
project_name      = "s3-upload-portal"
github_repo       = "your-org/s3-upload-portal"
state_bucket      = "your-tofu-state-bucket-name"
state_lock_table  = "your-tofu-lock-table-name"

# Optional — defaults shown. Used in resource names as {project_name}-{environment}.
# environment = "prod"

# Optional — Hosted UI domain prefix (must be globally unique across all AWS).
# Defaults to {project_name}-{environment}-portal when unset.
# cognito_domain_prefix = ""

# SPEC-186 FR-004 — who may assume the read-only verification role for live checks
# (catalog GetTable/GetTableVersions and the archive audit record).
#
# DELIBERATELY NOT SETTABLE HERE. This file once carried a commented
# `verification_principal_arns` line, and acting on it would have destroyed production: no
# human identity in this account can run a local `tofu apply`, because the laptop IAM user is
# not on the data buckets' policy allowlists and tofu therefore reads dat-prod-user-space and
# dat-prod-archive as ABSENT and plans to recreate them (measured 2026-08-14, 13 to destroy).
# The value is a repo variable, applied by CI:
#
#   gh variable set TF_VAR_verification_principal_arns \
#     --body '["arn:aws:iam::123456789012:user/your-iam-user"]'
#
# Unset, the role is not created; the CloudTrail trail over the archive vault ships regardless.

# ── Front-door domain (SPEC-193 FR-006) ──────────────────────────────────────
# The registrable domain whose subdomains serve the SPA and the API, and the
# hosted zone that answers for it. DELIBERATELY NOT SETTABLE HERE, for the same
# reason as verification_principal_arns above: no human identity in this account
# can run a local apply. Both are repo variables, applied by CI:
#
#   gh variable set TF_VAR_parent_domain   --body 'example.com'
#   gh variable set TF_VAR_route53_zone_id --body 'Z0123456789ABCDEFGHIJ'
#
# route53_zone_id must be the BARE id — strip the /hostedzone/ prefix the Route 53
# API returns. The value is rendered into the deploy role's Route 53 grant as well
# as into the records themselves, and IAM matches ARNs literally, so the prefixed
# form yields a grant that matches nothing. A variable validation refuses it.
#
# Optional, defaulting to portal/api. The workflow supplies the same defaults with
# `||` so an unset repo variable never arrives as the empty string, which WOULD
# override the default here and yield the host ".example.com":
#
#   gh variable set TF_VAR_spa_subdomain --body 'portal'
#   gh variable set TF_VAR_api_subdomain --body 'api'
