.terraform/
*.tfstate
*.tfstate.backup
*.tfvars
backend.conf

# Lambda placeholder zip generated by archive_file at plan/apply time (SPEC-012).
# Real Lambda code lives in /lambdas and is deployed by deploy-lambdas.yml.
modules/*/build/

# Left behind by the per-module `tofu init` the plan job runs to validate modules the root
# does not call. Ignored for the same reason `.terraform/` is: it is a build artefact of a check.
.terraform.lock.hcl
