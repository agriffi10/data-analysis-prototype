{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "EmitNotifications",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "${notifications_queue_arn}"
    },
    {
      "Sid": "RegistryRead",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "${admin_bucket_arn}/shared-spaces/*"
    },
    {
      "Sid": "RegistryList",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "${admin_bucket_arn}",
      "Condition": {
        "StringLike": {
          "s3:prefix": "shared-spaces/*"
        }
      }
    },
    {
      "Sid": "SpaceLockReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "${admin_bucket_arn}/${lock_prefix}/*"
    },
    {
      "Sid": "PlanReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "${admin_bucket_arn}/${plan_prefix}/*"
    },
    {
      "Sid": "ListPlanPrefixForHonestAbsence",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "${admin_bucket_arn}",
      "Condition": {
        "StringLike": {
          "s3:prefix": "${plan_prefix}/*"
        }
      }
    },
    {
      "Sid": "ListSpaces",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket",
        "s3:GetBucketLocation"
      ],
      "Resource": [
        "${user_space_bucket_arn}",
        "${shared_space_bucket_arn}"
      ]
    },
    {
      "Sid": "ReadSpaceObjects",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": [
        "${user_space_bucket_arn}/*",
        "${shared_space_bucket_arn}/*"
      ]
    },
    {
      "Sid": "WriteSpaceObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:AbortMultipartUpload",
        "s3:ListMultipartUploadParts"
      ],
      "Resource": [
        "${user_space_bucket_arn}/*",
        "${shared_space_bucket_arn}/*"
      ]
    },
    {
      "Sid": "DeleteSpaceObjects",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": [
        "${user_space_bucket_arn}/*",
        "${shared_space_bucket_arn}/*"
      ]
    },
    {
      "Sid": "NeverOverwritePortalManagedObjects",
      "Effect": "Deny",
      "Action": "s3:PutObject",
      "Resource": [
        "${user_space_bucket_arn}/*/system_settings/athenaresults/*",
        "${shared_space_bucket_arn}/*/system_settings/athenaresults/*",
        "${user_space_bucket_arn}/*/user_settings/*",
        "${shared_space_bucket_arn}/*/user_settings/*",
        "${user_space_bucket_arn}/*/system_settings/archive/*",
        "${shared_space_bucket_arn}/*/system_settings/archive/*",
        "${user_space_bucket_arn}/_config/*",
        "${user_space_bucket_arn}/_directory/*"
      ]
    },
    {
      "Sid": "NeverDeletePortalManagedObjects",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": [
        "${user_space_bucket_arn}/*/system_settings/athenaresults/*",
        "${shared_space_bucket_arn}/*/system_settings/athenaresults/*",
        "${user_space_bucket_arn}/*/user_settings/*",
        "${shared_space_bucket_arn}/*/user_settings/*",
        "${user_space_bucket_arn}/*/system_settings/archive/*",
        "${shared_space_bucket_arn}/*/system_settings/archive/*",
        "${user_space_bucket_arn}/*/DO_NOT_DELETE.txt",
        "${shared_space_bucket_arn}/*/DO_NOT_DELETE.txt",
        "${user_space_bucket_arn}/_config/*",
        "${user_space_bucket_arn}/_directory/*"
      ]
    },
    {
      "Sid": "NoLockDelete",
      "Effect": "Deny",
      "Action": "s3:DeleteObject",
      "Resource": "${admin_bucket_arn}/*"
    },
    {
      "Sid": "ReadTimedOutExecutionInput",
      "Effect": "Allow",
      "Action": "states:DescribeExecution",
      "Resource": "${execution_arn_wildcard}"
    },
    {
      "Sid": "EmitStructuredLogEvents",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "${logs_queue_arn}"
    },
    {
      "Sid": "WriteLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "${log_group_arn}:*"
    }
  ]
}
