{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DrainLogsQueue",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "${logs_queue_arn}"
    },
    {
      "Sid": "AppendLogObjects",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "${admin_bucket_arn}/${logs_prefix}/*"
    },
    {
      "Sid": "WriteOwnCloudWatchLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "${log_group_arn}:*"
    }
  ]
}
