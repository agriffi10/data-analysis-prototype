{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FeedbackDocReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "${admin_bucket_arn}/feedback/*"
    },
    {
      "Sid": "RequestQueueReceive",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "${request_queue_arn}"
    },
    {
      "Sid": "WriteLogs",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogStream",
        "logs:PutLogEvents"
      ],
      "Resource": "${lambda_log_group_arn}:*"
    },
    {
      "Sid": "EmitStructuredLogs",
      "Effect": "Allow",
      "Action": "sqs:SendMessage",
      "Resource": "${logs_queue_arn}"
    }
  ]
}
